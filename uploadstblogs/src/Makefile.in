                              -lcjson -lsecure_wrapper -lfwutils -lcrypto -lrfcapi -lz -lIARMBus  -lparsejson \
                              -lt2utils -ltelemetry_msgsender -L$(PKG_CONFIG_SYSROOT_DIR)/usr/lib -luploadutil

