	-rm -f ../../uploadstblogs/unittest/mocks/$(am__dirstamp)
	-rm -f ../src/$(DEPDIR)/$(am__dirstamp)
	-rm -f ../src/$(am__dirstamp)

maintainer-clean-generic:
