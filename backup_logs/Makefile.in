@am__fastdepCC_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/backup_logs-backup_logs.Tpo $(DEPDIR)/backup_logs-backup_logs.Po
@AMDEP_TRUE@@am__fastdepCC_FALSE@	$(AM_V_CC)source='src/backup_logs.c' object='backup_logs-backup_logs.obj' libtool=no @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCC_FALSE@	DEPDIR=$(DEPDIR) $(CCDEPMODE) $(depcomp) @AMDEPBACKSLASH@
