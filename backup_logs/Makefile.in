backup_logs-backup_logs.o: src/backup_logs.c
@am__fastdepCC_TRUE@	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(backup_logs_CPPFLAGS) $(CPPFLAGS) $(backup_logs_CFLAGS) $(CFLAGS) -MT backup_logs-backup_logs.o -MD -MP -MF $(DEPDIR)/backup_logs-backup_logs.Tpo -c -o backup_logs-backup_logs.o `test -f 'src/backup_logs.c' || echo '$(srcdir)/'`src/backup_logs.c
@am__fastdepCC_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/backup_logs-backup_logs.Tpo $(DEPDIR)/backup_logs-backup_logs.Po
@AMDEP_TRUE@@am__fastdepCC_FALSE@	$(AM_V_CC)source='src/backup_logs.c' object='backup_logs-backup_logs.o' libtool=no @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCC_FALSE@	DEPDIR=$(DEPDIR) $(CCDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCC_FALSE@	$(AM_V_CC@am__nodep@)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(backup_logs_CPPFLAGS) $(CPPFLAGS) $(backup_logs_CFLAGS) $(CFLAGS) -c -o backup_logs-backup_logs.o `test -f 'src/backup_logs.c' || echo '$(srcdir)/'`src/backup_logs.c

